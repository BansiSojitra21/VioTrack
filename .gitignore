# Git ignore for the TrafficAI / VioTrack monorepo (frontend + backend)

# Local secrets and configuration
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Node dependencies and generated output
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/coverage/
**/.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python environments, caches, and test artifacts
**/__pycache__/
*.py[cod]
*$py.class
**/.venv/
**/.venv*/
**/venv/
**/ENV/
**/.pytest_cache/
**/.pytest-*/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/*.egg-info/
**/.ipynb_checkpoints/
pytestdebug.log

# Runtime data, uploads, evidence, and local SQLite
/backend/data/
**/trafficai.sqlite
**/trafficai.sqlite-*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# Downloaded / local model weights and training runs
*.pt
*.onnx
*.engine
*.weights
**/runs/
**/wandb/
backend/app/weights/*
!backend/app/weights/README.md
!backend/app/weights/.gitkeep

# Logs, certificates, editor, and OS metadata
*.log
*.pem
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Local tooling / agent scratch
.tmp/
tmp/
temp/

# Preserved metadata from the original frontend-only Git repository
/.git-frontend-backup/
