APP_NAME=TrafficAI
DATA_DIR=./data
DATABASE_PATH=
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=180
MAX_FRAMES=2400
FRAME_STRIDE=2
YOLO_WEIGHTS=yolo11n.pt
# Custom helmet detector (without_helmet / with_helmet). Train via scripts/train_helmet.py
HELMET_WEIGHTS=helmet.pt
YOLO_CONF=0.32
YOLO_IOU=0.50
YOLO_IMGSZ=640
TRACK_BUFFER=30
# Use cpu on every machine so YOLO boxes match. Set DEVICE=0 only for speed (results may drift).
DEVICE=cpu
DETERMINISTIC=true
INFERENCE_SEED=0
ALLOW_WEIGHT_DOWNLOAD=false
CLOUDINARY_URL=
LOG_LEVEL=INFO
